{
  "name": "clojure-atlas",
  "version": "0.2.0",
  "description": "A structural map of any Clojure, ClojureScript or .cljc codebase, served to AI coding agents as MCP tools.",
  "license": "MIT",
  "author": "Barış Can Ateş",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bariscanates404/clojure-atlas.git"
  },
  "homepage": "https://github.com/Bariscanates404/clojure-atlas",
  "bugs": {
    "url": "https://github.com/Bariscanates404/clojure-atlas/issues"
  },
  "type": "module",
  "bin": {
    "clojure-atlas": "dist/cli.js"
  },
  "exports": {
    "./cli": {
      "default": "./dist/cli.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./build/*": {
      "types": "./dist/build/*.d.ts",
      "default": "./dist/build/*.js"
    },
    "./mcp/*": {
      "types": "./dist/mcp/*.d.ts",
      "default": "./dist/mcp/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "clojure",
    "clojurescript",
    "mcp",
    "code-graph",
    "ai-agents",
    "clj-kondo"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=98 \"test/*.test.ts\"",
    "coverage": "node scripts/coverage.ts",
    "bench": "node bench/score.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  },
  "optionalDependencies": {
    "typescript": "5.9.2"
  }
}
