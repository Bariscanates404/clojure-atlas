{
  "name": "clojure-atlas",
  "version": "0.1.0",
  "description": "A structural map of any Clojure, ClojureScript or .cljc codebase, served to AI coding agents as MCP tools.",
  "license": "MIT",
  "author": "Barış Can Ateş",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bariscanates404/clojure-atlas.git"
  },
  "homepage": "https://github.com/Bariscanates404/clojure-atlas",
  "type": "module",
  "bin": {
    "clojure-atlas": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "clojure",
    "clojurescript",
    "mcp",
    "code-graph",
    "ai-agents",
    "clj-kondo"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=98 \"test/*.test.ts\"",
    "coverage": "node scripts/coverage.ts",
    "bench": "node bench/score.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.2"
  }
}
